# Auto-generated by unplugin-vue-components / unplugin-vue-router / unplugin-auto-import.
# Rewritten on every `dev` or `build` run — tracking these causes every
# server-side build to leave local changes that block the next `git pull`.
components.d.ts
typed-router.d.ts
auto-imports.d.ts
.eslintrc-auto-import.json

# Ignore MSW script
public/mockServiceWorker.js

# Env files
.env*
!.env.example
